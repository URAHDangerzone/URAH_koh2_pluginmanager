<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>URAH_PluginManager</AssemblyName>
    <RootNamespace>URAH_PluginManager</RootNamespace>
    <URAHModLink>false</URAHModLink>
    <!-- shared/ of the workspace (URAH_koh2_knowledge) when there, else the submodule -->
    <URAHShared Condition="'$(URAHShared)' == '' and Exists('$(MSBuildProjectDirectory)/../../../shared/URAH.Plugin.props')">$(MSBuildProjectDirectory)/../../../shared</URAHShared>
    <URAHShared Condition="'$(URAHShared)' == ''">$(MSBuildProjectDirectory)/../external/URAH_shared</URAHShared>
  </PropertyGroup>

  <Import Project="$(URAHShared)/URAH.Plugin.props" />

  <ItemGroup>
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestModule" HintPath="$(ManagedDir)/UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPlugins)/URAH_PluginManager" />
  </Target>

</Project>
